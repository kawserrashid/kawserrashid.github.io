---
// Research (docs/06-pages.md § Research, FR-13): publications first, then write-ups.
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { getResearch } from '../lib/content';
import { researchPage as page } from '../lib/research'; // copy lives in src/data/research.json

const writeups = await getResearch();
---

<BaseLayout title={page.title} description={page.intro}>
  <header class="container intro">
    <h1>{page.title}</h1>
    <p>{page.intro}</p>
  </header>

  <section id="publications" class="band" aria-labelledby="pubs-title">
    <div class="container">
      <div class="stack prose-width">
        <h2 id="pubs-title" class="sub-title">{page.publications.title}</h2>
        <PublicationList />
      </div>
    </div>
  </section>

  <section id="writeups" class="container stack writeups" aria-labelledby="writeups-title">
    <div class="head">
      <h2 id="writeups-title" class="sub-title">{page.writeups.title}</h2>
      <p class="hint">{page.writeups.hint}</p>
    </div>
    <div class="cards">
      {writeups.map((entry) => <ResearchCard entry={entry} href="/research/" />)}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: 72px 56px;
  }
  h1 {
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-olive);
  }
  .intro p {
    max-width: 680px;
    color: var(--color-text-secondary);
  }

  .sub-title {
    font-size: 1.75rem;
    font-weight: 500;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .band {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
    padding-block: 56px;
    /* Leave room above the heading when jumping to #publications. */
    scroll-margin-top: 16px;
  }
  .prose-width {
    max-width: var(--width-prose); /* citations read better in a narrower column */
  }

  .writeups {
    padding-block: 56px 72px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .hint {
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    color: var(--color-text-secondary);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 28px;
  }
</style>
