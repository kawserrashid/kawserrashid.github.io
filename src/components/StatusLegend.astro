---
// Explains the three statuses. Sits under the Sketch Board heading on Home.
import { statuses } from '../lib/status';
const entries = Object.values(statuses);
---

<ul class="legend" aria-label="Status legend">
  {entries.map(({ label, blurb, icon: Icon, color }) => (
    <li>
      <Icon size={20} stroke-width={1.8} color={color} aria-hidden="true" />
      <span><strong>{label}</strong>: {blurb}</span>
    </li>
  ))}
</ul>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  strong {
    font-weight: 700;
    color: var(--color-text-body);
  }
</style>
