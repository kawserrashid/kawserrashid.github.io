---
// Site header: wordmark + main nav. The current page gets aria-current="page".
import { navItems } from '../data/nav';

// Compare paths without trailing slashes so "/about" and "/about/" match.
const strip = (p: string) => p.replace(/\/+$/, '') || '/';
const current = strip(Astro.url.pathname);
const isCurrent = (href: string) => {
  const target = strip(href);
  return current === target || current.startsWith(target + '/');
};
---

<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a class="wordmark" href="/" aria-current={current === '/' ? 'page' : undefined}>Kawser</a>
    <ul class="links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: 20px;
    font-family: var(--font-sans);
    font-size: var(--text-ui);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--text-wordmark);
    font-weight: 600;
    color: var(--color-text-body);
    text-decoration: none;
  }
  .wordmark:hover {
    color: var(--color-text-heading);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Cancel the links' outer padding so link text lines up with the page edges. */
    margin-inline: -12px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-inline: 12px;
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--color-text-heading);
  }
  .links a[aria-current='page'] {
    color: var(--color-olive);
    font-weight: 700;
  }
</style>
