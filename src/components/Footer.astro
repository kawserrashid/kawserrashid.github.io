---
// Site footer: copyright on the left, contact links (from profile.json) on the right.
import profile from '../data/profile.json';

const year = new Date().getFullYear(); // evaluated at build time
const links = [
  { label: 'Email', href: `mailto:${profile.email}` },
  { label: 'GitHub', href: profile.links.github },
  { label: 'Google Scholar', href: profile.links.scholar },
  { label: 'LinkedIn', href: profile.links.linkedin },
];
---

<footer class="site-footer">
  <div class="container inner">
    <p class="copy">© {year} {profile.name} · Built with Astro</p>
    <ul class="links" aria-label="Contact">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: 48px 56px;
    font-family: var(--font-sans);
    font-size: var(--text-ui);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .copy {
    color: var(--color-text-label);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
</style>
