---
// A row of quote cards drifting right → left in an endless loop. CSS only, no JS.
// Seamless loop: the list is rendered twice and the track slides by exactly
// half its width (one copy), then restarts — the jump is invisible.
// - The second copy is aria-hidden, so screen readers hear each quote once.
// - Pauses on hover and on keyboard focus (the strip itself is focusable).
// - Reduced motion: no animation; the strip becomes a swipeable/scrollable row.
interface Quote {
  text: string;
  author: string;
  source?: string;
}
interface Props {
  quotes: Quote[];
  label: string; // accessible name for the scrollable strip
}
const { quotes, label } = Astro.props;
const copies = [false, true]; // [visible to screen readers, hidden duplicate]
---

<div class="marquee" tabindex="0" role="region" aria-label={label}>
  <div class="track">
    {copies.map((hidden) => (
      <ul class:list={['set', { duplicate: hidden }]} aria-hidden={hidden ? 'true' : undefined}>
        {quotes.map((q) => (
          <li>
            <figure class="card">
              <span class="mark" aria-hidden="true">“</span>
              <blockquote>{q.text}</blockquote>
              <figcaption>— {q.author}{q.source && <>, <cite>{q.source}</cite></>}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    /* Soft fade at both edges instead of a hard cut. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee:focus-visible {
    outline-offset: -2px;
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 70s linear infinite;
  }
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .set {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: min(400px, 80vw);
    height: 100%;
    margin: 0 24px 0 0;
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }
  .mark {
    font-size: 3rem;
    line-height: 0.6;
    color: var(--color-olive);
  }
  blockquote {
    margin: 0;
    font-size: 1.3125rem; /* 21px */
    line-height: 1.5;
    font-style: italic;
    color: var(--color-text-heading);
  }
  figcaption {
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    color: var(--color-text-label);
  }
  cite {
    font-style: normal;
  }

  /* Reduced motion: no movement; swipe or scroll instead; no duplicate copy. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }
    .track {
      animation: none;
      padding-inline: var(--gutter);
    }
    .duplicate {
      display: none;
    }
    .card {
      scroll-snap-align: start;
    }
  }
</style>
