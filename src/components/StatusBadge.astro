---
// Status shown as icon + word (never color alone). Optional topic after a dot.
import { statuses, type Status } from '../lib/status';

interface Props {
  status: Status;
  topic?: string;
  caps?: boolean; // uppercase label style (cards) vs. plain (lists)
}
const { status, topic, caps = false } = Astro.props;
const { label, icon: Icon, color } = statuses[status];
---

<span class:list={['badge', { caps }]} style={`--status-color: ${color}`}>
  <Icon size={16} stroke-width={2} aria-hidden="true" />
  <span>{label}{topic && <> · {topic}</>}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
    line-height: 1.3;
    color: var(--status-color);
  }
  .badge :global(svg) {
    flex-shrink: 0;
  }
  .caps {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
